# Copy to .env for local overrides. Never commit .env.

# --- application -----------------------------------------------------------
RAG_LAB_ENVIRONMENT=development
RAG_LAB_DEBUG=false
RAG_LAB_LOG_LEVEL=INFO

# Relative paths resolve against the repository root.
RAG_LAB_DATABASE_PATH=data/rag_lab.db
RAG_LAB_SAMPLE_DOCS_DIR=data/sample_docs
RAG_LAB_EVAL_DATASET_PATH=eval/dataset.jsonl
RAG_LAB_EVAL_RESULTS_DIR=eval/results
RAG_LAB_AUTO_INGEST_SAMPLE_DOCS=true

# --- chunking and retrieval ------------------------------------------------
RAG_LAB_CHUNK_SIZE=760
RAG_LAB_CHUNK_OVERLAP=110
RAG_LAB_TOP_K=5
RAG_LAB_MIN_RETRIEVAL_SCORE=0.22
RAG_LAB_MIN_QUERY_COVERAGE=0.30
RAG_LAB_EMBEDDING_PROVIDER=hashing
RAG_LAB_EMBEDDING_DIMENSION=384

# --- generation ------------------------------------------------------------
# extractive (offline, deterministic) or openai (OpenAI-compatible API).
RAG_LAB_GENERATOR_PROVIDER=extractive
RAG_LAB_MAX_CONTEXT_CHARS=9000
RAG_LAB_MAX_ANSWER_CHARS=1200
RAG_LAB_EXPERIENCE_REUSE_ENABLED=true
RAG_LAB_EXPERIENCE_MIN_QUALITY=0.75

# Only needed when RAG_LAB_GENERATOR_PROVIDER=openai.
# RAG_LAB_OPENAI_API_KEY=sk-...
# RAG_LAB_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_LAB_OPENAI_MODEL=gpt-4o-mini
# RAG_LAB_OPENAI_TIMEOUT_SECONDS=45

# --- uploads ---------------------------------------------------------------
RAG_LAB_MAX_DOCUMENT_BYTES=2000000
RAG_LAB_MAX_QUESTION_CHARS=2000

# --- Redis cache (opt-in; default OFF) --------------------------------------
# With CACHE_ENABLED=false the app never contacts Redis and all requests work
# without Redis installed. RAG_LAB_-prefixed aliases are also accepted.
CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_KEY_PREFIX=raglab
CACHE_ENV=local
# Current documents are global. If tenant/ACL filtering is introduced, set a
# per-deployment or per-request permission fingerprint here.
CACHE_SCOPE=public

# TTLs are seconds with ±10% jitter to avoid synchronized expiry.
EMBEDDING_TTL=604800
RETRIEVAL_TTL=1800
ANSWER_TTL=900
CACHE_TTL_JITTER=0.10

# Fail-fast budget: socket timeout is intentionally <=100ms.
REDIS_CONNECT_TIMEOUT=0.50
REDIS_SOCKET_TIMEOUT=0.10
REDIS_MAX_CONNECTIONS=20
REDIS_POOL_WAIT_TIMEOUT=0.10
REDIS_HEALTH_CHECK_INTERVAL=30

# After 3 consecutive errors, skip Redis for 30s instead of slow-failing.
CACHE_FAIL_OPEN_COOLDOWN=30
CACHE_ERROR_THRESHOLD=3
CACHE_SINGLEFLIGHT_TIMEOUT=1.0

# Empty retrieval results are not cached unless this is explicitly enabled.
NEGATIVE_CACHE_ENABLED=false
RETRIEVAL_NEGATIVE_TTL=60

# Optional semantic layer is reserved and disabled. Never mixed into exact
# cache metrics or default evaluation conclusions.
SEMANTIC_CACHE_ENABLED=false
